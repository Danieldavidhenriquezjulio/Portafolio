  }
  .pd-stat-card:hover {
    border-color: rgba(0, 217, 255, 0.2);
    transform: translateY(-3px);
    box-shadow: 0 12px 40px rgba(0, 217, 255, 0.06);
  }

  .pd-stat-icon {
    width: 38px; height: 38px;
    display: flex; align-items: center; justify-content: center;
    font-size: 18px;
    color: var(--cyan);
    background: rgba(0, 217, 255, 0.06);
    border: 1px solid rgba(0, 217, 255, 0.12);
    border-radius: 10px;
    flex-shrink: 0;
  }
  .pd-stat-icon-status[data-status="ACTIVE"] { color: #00ff88; border-color: rgba(0,255,136,0.2); background: rgba(0,255,136,0.06); }
  .pd-stat-icon-status[data-status="IN PROGRESS"] { color: #ffbb00; border-color: rgba(255,187,0,0.2); background: rgba(255,187,0,0.06); }

  .pd-stat-info {
    display: flex;
    flex-direction: column;
    gap: 4px;
    min-width: 0;
  }

  .pd-stat-label {
    font-size: 8px;
    letter-spacing: 2px;
    color: var(--text-muted);
    opacity: 0.5;
  }

  .pd-stat-value {
    font-size: 12px;
    color: var(--text-primary);
    font-weight: 500;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .pd-stat-glow {
    position: absolute;
    bottom: 0; left: 0; right: 0;
    height: 1px;
    background: linear-gradient(90deg, transparent, var(--cyan), transparent);
    opacity: 0;
    transition: opacity 0.4s ease;
  }
  .pd-stat-card:hover .pd-stat-glow { opacity: 0.6; }

  /* --- GALLERY --- */
  .pd-gallery {
    animation: pd-slide-up 0.7s ease both;
    animation-delay: 0.4s;
  }

  .pd-gallery-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(340px, 1fr));
    gap: 20px;
  }

  .pd-gal-card {
    opacity: 0;
    animation: pd-fade-up 0.6s ease forwards;
    animation-delay: var(--gal-delay);
  }

  .pd-gal-frame {
    position: relative;
    overflow: hidden;
    border: 1px solid rgba(0, 217, 255, 0.08);
    aspect-ratio: 16 / 10;
    background: #0a0e1a;
    cursor: pointer;
    transition: all 0.4s cubic-bezier(0.2, 0.8, 0.2, 1);
  }
  .pd-gal-frame:hover {
    border-color: rgba(0, 217, 255, 0.35);
    box-shadow: 0 16px 48px rgba(0, 217, 255, 0.1), inset 0 0 40px rgba(0, 217, 255, 0.02);
    transform: translateY(-6px) scale(1.01);
  }

  .pd-gal-frame img {
    width: 100%; height: 100%;
    object-fit: cover;
    transition: transform 0.7s cubic-bezier(0.2, 0.8, 0.2, 1);
  }
  .pd-gal-frame:hover img { transform: scale(1.08); }

  .pd-gal-hud {
    position: absolute; inset: 0;
    display: flex; flex-direction: column;
    justify-content: space-between;
    padding: 14px;
    opacity: 0;
    transition: opacity 0.35s ease;
    background: linear-gradient(to bottom, rgba(3,7,18,0.6) 0%, transparent 35%, transparent 65%, rgba(3,7,18,0.7) 100%);
  }
  .pd-gal-frame:hover .pd-gal-hud { opacity: 1; }

  .pd-gal-hud-top, .pd-gal-hud-bottom {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .pd-gal-tag {
    font-size: 9px;
    letter-spacing: 2px;
    color: var(--cyan);
    padding: 3px 8px;
    border: 1px solid rgba(0, 217, 255, 0.3);
    background: rgba(0, 217, 255, 0.1);
  }

  .pd-gal-rec {
    font-size: 9px;
    letter-spacing: 2px;
    color: #ff4444;
    display: flex;
    align-items: center;
    gap: 5px;
  }
  .pd-rec-dot {
    width: 5px; height: 5px;
    background: #ff4444;
    border-radius: 50%;
    animation: pd-pulse 1s ease-in-out infinite;
  }

  .pd-gal-res {
    font-size: 8px;
    letter-spacing: 2px;
    color: var(--text-muted);
  }

  .pd-gal-zoom {
    color: var(--text-muted);
    font-size: 16px;
    transition: color 0.3s;
  }
  .pd-gal-frame:hover .pd-gal-zoom { color: var(--cyan); }

  .pd-gal-scan {
    position: absolute;
    top: 0; left: 0; right: 0;
    height: 2px;
    background: linear-gradient(90deg, transparent, var(--cyan), transparent);
    opacity: 0;
    animation: pd-image-scan 4s ease-in-out infinite;
  }
  .pd-gal-frame:hover .pd-gal-scan { opacity: 0.5; }

  @keyframes pd-image-scan {
    0%   { top: 0; }
    100% { top: 100%; }
  }

  /* --- CTA --- */
  .pd-cta {
    animation: pd-slide-up 0.7s ease both;
    animation-delay: 0.45s;
  }

  .pd-cta-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 28px 36px;
    background: rgba(11, 16, 32, 0.7);
    backdrop-filter: blur(12px);
    border: 1px solid rgba(0, 217, 255, 0.08);
    position: relative;
    overflow: hidden;
  }
  .pd-cta-inner::before {
    content: '';
    position: absolute;
    top: 0; left: 0; right: 0;
    height: 1px;
    background: linear-gradient(90deg, transparent, var(--cyan), var(--purple), transparent);
    opacity: 0.4;
  }

  .pd-cta-label {
    font-size: 11px;
    letter-spacing: 4px;
    color: var(--text-muted);
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .pd-cta-label i { color: var(--cyan); font-size: 18px; }

  .pd-cta-btns {
    display: flex;
    gap: 14px;
  }

  .pd-cta-btn {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 14px 30px;
    font-family: 'Orbitron', sans-serif;
    font-size: 10px;
    letter-spacing: 3px;
    text-decoration: none;
    border: 1px solid;
    overflow: hidden;
    transition: all 0.4s cubic-bezier(0.2, 0.8, 0.2, 1);
    z-index: 1;
  }

  .pd-cta-btn-bg {
    position: absolute;
    inset: 0;
    opacity: 0;
    transition: opacity 0.4s ease;
    z-index: -1;
  }

  .pd-cta-cyan {
    color: var(--cyan);
    border-color: rgba(0, 217, 255, 0.4);
  }
  .pd-cta-cyan .pd-cta-btn-bg { background: linear-gradient(135deg, rgba(0, 217, 255, 0.15), rgba(0, 217, 255, 0.05)); }
  .pd-cta-cyan:hover {
    border-color: var(--cyan);
    box-shadow: 0 0 30px rgba(0, 217, 255, 0.15), 0 0 60px rgba(0, 217, 255, 0.05);
    transform: translateY(-3px);
  }
  .pd-cta-cyan:hover .pd-cta-btn-bg { opacity: 1; }

  .pd-cta-purple {
    color: var(--purple);
    border-color: rgba(123, 97, 255, 0.4);
  }
  .pd-cta-purple .pd-cta-btn-bg { background: linear-gradient(135deg, rgba(123, 97, 255, 0.15), rgba(123, 97, 255, 0.05)); }
  .pd-cta-purple:hover {
    border-color: var(--purple);
    box-shadow: 0 0 30px rgba(123, 97, 255, 0.15), 0 0 60px rgba(123, 97, 255, 0.05);
    transform: translateY(-3px);
  }
  .pd-cta-purple:hover .pd-cta-btn-bg { opacity: 1; }

  /* Footer */
  .pd-footer {
    text-align: center;
    font-size: 8px;
    letter-spacing: 4px;
    color: var(--text-muted);
    opacity: 0.3;
    padding: 20px 0 8px;
  }

  /* --- KEYFRAMES --- */
  @keyframes pd-spin { to { transform: rotate(360deg); } }
  @keyframes pd-blink { 50% { opacity: 0; } }
  @keyframes pd-pulse {
    0%,100% { opacity: 1; }
    50% { opacity: 0.3; }
  }

  @keyframes pd-slide-down {
    from { opacity: 0; transform: translateY(-20px); }
    to { opacity: 1; transform: translateY(0); }
  }
  @keyframes pd-slide-up {
    from { opacity: 0; transform: translateY(30px); }
    to { opacity: 1; transform: translateY(0); }
  }
  @keyframes pd-fade-right {
    from { opacity: 0; transform: translateX(-16px); }
    to { opacity: 1; transform: translateX(0); }
  }
  @keyframes pd-fade-up {
    from { opacity: 0; transform: translateY(24px); }
    to { opacity: 1; transform: translateY(0); }
  }

  /* --- RESPONSIVE --- */
  @media (max-width: 960px) {
    .pd-hero-body { flex-direction: column; text-align: center; }
    .pd-emblem { margin-top: 20px; }
    .pd-chip-row { justify-content: center; }
    .pd-hero-bar { justify-content: center; flex-wrap: wrap; }
    .pd-dual-grid { grid-template-columns: 1fr; }
    .pd-stats-grid { grid-template-columns: repeat(2, 1fr); }
    .pd-cta-inner { flex-direction: column; gap: 20px; text-align: center; }
    .pd-nav { flex-direction: column; gap: 12px; align-items: flex-start; }
    .pd-class-line { justify-content: center; }
  }

  @media (max-width: 640px) {
    .pd-container { padding: 70px 16px 40px; gap: 24px; }
    .pd-hero { padding: 32px 24px 0; }
    .pd-title { letter-spacing: 3px; }
    .pd-stats-grid { grid-template-columns: 1fr; }
    .pd-gallery-grid { grid-template-columns: 1fr; }
    .pd-cta-btns { flex-direction: column; width: 100%; }
    .pd-cta-btn { justify-content: center; width: 100%; }
    .pd-panel { padding: 24px; }
    .pd-breadcrumbs { display: none; }
  }
</style>

<script>
  // ─── Floating particles ───
  (function createParticles() {
    const c = document.getElementById('pd-particles');
    if (!c) return;
    const count = 35;
    for (let i = 0; i < count; i++) {
      const d = document.createElement('div');
      const s = Math.random() * 2 + 0.5;
      const isCyan = Math.random() > 0.35;
      const dur = 10 + Math.random() * 15;
      const delay = Math.random() * dur;
      d.style.cssText = `
        position:absolute;
        width:${s}px; height:${s}px;
        background:${isCyan ? 'rgba(0,217,255,0.35)' : 'rgba(123,97,255,0.35)'};
        border-radius:50%;
        left:${Math.random()*100}%;
        top:${Math.random()*100}%;
        animation: pdFloat ${dur}s ease-in-out ${delay}s infinite;
        pointer-events:none;
      `;
      c.appendChild(d);
    }
  })();

  // ─── Inject particle keyframes ───
  if (!document.getElementById('pd-kf')) {
    const s = document.createElement('style');
    s.id = 'pd-kf';
    s.textContent = `
      @keyframes pdFloat {
        0%, 100% { transform: translate(0, 0) scale(1); opacity: 0.2; }
        33% { transform: translate(15px, -30px) scale(1.3); opacity: 0.5; }
        66% { transform: translate(-10px, -60px) scale(0.9); opacity: 0.3; }
      }
    `;
    document.head.appendChild(s);
  }

  // ─── Scroll-triggered reveal ───
  const observer = new IntersectionObserver((entries) => {
    entries.forEach(e => {
      if (e.isIntersecting) {
        e.target.style.opacity = '1';
        e.target.style.transform = 'translateY(0)';
      }
    });
  }, { threshold: 0.08 });

  document.querySelectorAll('.pd-panel, .pd-stat-card, .pd-gal-card').forEach(el => {
    if (!el.style.animationDelay) {
      el.style.opacity = '0';
      el.style.transform = 'translateY(20px)';
      el.style.transition = 'opacity 0.6s ease, transform 0.6s ease';
    }
    observer.observe(el);
  });

  // ─── Tech bar animation on scroll ───
  const techObs = new IntersectionObserver((entries) => {
    entries.forEach(e => {
      if (e.isIntersecting) {
        e.target.querySelectorAll('.pd-tech-bar-fill').forEach(bar => {
          bar.style.transition = 'width 1.2s cubic-bezier(0.2, 0.8, 0.2, 1)';
          bar.style.width = bar.style.getPropertyValue('--width') || '90%';
        });
      }
    });
  }, { threshold: 0.3 });

  document.querySelectorAll('.pd-panel-tech').forEach(el => techObs.observe(el));

  // ─── Parallax subtle on hero ───
  const hero = document.getElementById('pd-hero');
  if (hero) {
    window.addEventListener('mousemove', (e) => {
      const x = (e.clientX / window.innerWidth - 0.5) * 8;
      const y = (e.clientY / window.innerHeight - 0.5) * 4;
      const emblem = hero.querySelector('.pd-emblem');
      if (emblem) {
        emblem.style.transform = `translate(${x}px, ${y}px)`;
        emblem.style.transition = 'transform 0.8s cubic-bezier(0.2, 0.8, 0.2, 1)';
      }
    });
  }
</script>

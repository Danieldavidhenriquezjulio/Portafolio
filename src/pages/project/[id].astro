---
import Layout from "../../layouts/Layout.astro";
import { projects } from "../../data/projects.js";

export function getStaticPaths() {
  return projects.map((project) => ({
    params: { id: project.id },
    props: { project },
  }));
}

const { project } = Astro.props;
const techItems = project.tech.split("·").map((t) => t.trim());
const isPrimary = project.primary;
const accentColor = isPrimary ? 'var(--purple)' : 'var(--cyan)';
---

<Layout title={`${project.name} - Mission Database`}>
  <main class="pd-page">
    <!-- Background layers -->
    <div class="pd-bg-grid"></div>
    <div class="pd-bg-noise"></div>
    <div class="pd-bg-vignette"></div>
    <div class="pd-particles" id="pd-particles"></div>
    <div class="pd-data-stream" id="pd-data-stream"></div>

    <div class="pd-container">

      <!-- ═══ TOP NAV ═══ -->
      <nav class="pd-nav" id="pd-nav">
        <a href="/#projects" class="pd-back-btn">
          <div class="pd-back-icon">
            <i class="ti ti-chevron-left"></i>
          </div>
          <span class="pd-back-text">RETURN TO TERMINAL</span>
        </a>
        <div class="pd-breadcrumbs orbitron">
          <span class="pd-crumb-dim">SYS</span>
          <i class="ti ti-chevron-right pd-crumb-arrow"></i>
          <span class="pd-crumb-dim">MISSIONS</span>
          <i class="ti ti-chevron-right pd-crumb-arrow"></i>
          <span class="pd-crumb-lit">{project.id.toUpperCase()}</span>
        </div>
      </nav>

      <!-- ═══ HERO SECTION ═══ -->
      <section class="pd-hero" id="pd-hero">
        <!-- Decorative corner HUD elements -->
        <div class="pd-hud-corner pd-hud-tl"></div>
        <div class="pd-hud-corner pd-hud-tr"></div>
        <div class="pd-hud-corner pd-hud-bl"></div>
        <div class="pd-hud-corner pd-hud-br"></div>
        <div class="pd-hero-glow"></div>
        <div class="pd-hero-scanlines"></div>

        <div class="pd-hero-body">
          <div class="pd-hero-info">
            <!-- Status pill -->
            <div class="pd-pill" data-status={project.status}>
              <span class="pd-pill-dot"></span>
              <span class="pd-pill-text">{project.status}</span>
            </div>

            <!-- Title with glitch data attribute -->
            <h1 class="pd-title orbitron" data-text={project.name}>
              {project.name}
            </h1>

            <!-- Classification subtitle -->
            <div class="pd-class-line">
              <span class="pd-class-bracket">[</span>
              <span class="pd-class-text">{project.class}</span>
              <span class="pd-class-bracket">]</span>
            </div>

            <!-- Sector & quick info chips -->
            <div class="pd-chip-row">
              <div class="pd-chip">
                <i class="ti ti-world"></i>
                {project.sector}
              </div>
              <div class="pd-chip">
                <i class="ti ti-layers-intersect"></i>
                {techItems.length} MODULES
              </div>
            </div>
          </div>

          <!-- Icon showcase with triple rings -->
          <div class="pd-emblem">
            <div class="pd-emblem-core">
              {project.logo ? (
                <img src={project.logo} alt={project.name} class="pd-emblem-img" />
              ) : (
                <Fragment set:html={project.icon || '<i class="ti ti-folder"></i>'} />
              )}
            </div>
            <div class="pd-ring pd-ring-1"></div>
            <div class="pd-ring pd-ring-2"></div>
            <div class="pd-ring pd-ring-3"></div>
            <!-- Orbiting dots -->
            <div class="pd-orbit-dot pd-orbit-dot-1"></div>
            <div class="pd-orbit-dot pd-orbit-dot-2"></div>
          </div>
        </div>

        <!-- Bottom data bar -->
        <div class="pd-hero-bar">
          <div class="pd-bar-item">
            <span class="pd-bar-label">SECTOR</span>
            <span class="pd-bar-value">{project.sector}</span>
          </div>
          <div class="pd-bar-sep"></div>
          <div class="pd-bar-item">
            <span class="pd-bar-label">CLASSIFICATION</span>
            <span class="pd-bar-value">{project.class}</span>
          </div>
          <div class="pd-bar-sep"></div>
          <div class="pd-bar-item">
            <span class="pd-bar-label">CLEARANCE</span>
            <span class="pd-bar-value">{isPrimary ? 'ALPHA' : 'STANDARD'}</span>
          </div>
        </div>
      </section>

      <!-- ═══ DUAL PANEL GRID ═══ -->
      <div class="pd-dual-grid">

        <!-- LEFT: Mission Briefing -->
        <section class="pd-panel pd-panel-brief">
          <div class="pd-panel-header">
            <div class="pd-panel-icon"><i class="ti ti-file-description"></i></div>
            <span class="pd-panel-title orbitron">MISSION BRIEFING</span>
            <div class="pd-panel-line"></div>
          </div>
          <div class="pd-brief-body">
            <p class="pd-brief-text">{project.longDesc || project.desc}</p>
          </div>
          <div class="pd-terminal">
            <div class="pd-terminal-header">
              <span class="pd-term-dot pd-term-dot-r"></span>
              <span class="pd-term-dot pd-term-dot-y"></span>
              <span class="pd-term-dot pd-term-dot-g"></span>
              <span class="pd-term-title">mission_log.sh</span>
            </div>
            <div class="pd-terminal-body">
              <div class="pd-term-line"><span class="pd-term-prompt">$</span> cat mission_status</div>
              <div class="pd-term-line pd-term-output">STATUS: {project.status} <span class="pd-term-cursor"></span></div>
            </div>
          </div>
        </section>

        <!-- RIGHT: Tech Arsenal -->
        <section class="pd-panel pd-panel-tech">
          <div class="pd-panel-header">
            <div class="pd-panel-icon"><i class="ti ti-cpu-2"></i></div>
            <span class="pd-panel-title orbitron">TECH ARSENAL</span>
            <div class="pd-panel-line"></div>
          </div>
          <div class="pd-tech-list">
            {techItems.map((tech, i) => (
              <div class="pd-tech-row" style={`--delay: ${i * 0.08}s`}>
                <div class="pd-tech-idx orbitron">{String(i + 1).padStart(2, "0")}</div>
                <div class="pd-tech-bar">
                  <div class="pd-tech-bar-fill" style={`--width: ${85 + Math.random() * 15}%`}></div>
                </div>
                <div class="pd-tech-label">{tech}</div>
                <div class="pd-tech-stat orbitron">{Math.floor(85 + Math.random() * 15)}%</div>
              </div>
            ))}
          </div>
          <div class="pd-tech-footer orbitron">
            <i class="ti ti-shield-check"></i>
            ALL SYSTEMS NOMINAL
          </div>
        </section>
      </div>

      <!-- ═══ SYSTEM METADATA ═══ -->
      <section class="pd-stats">
        <div class="pd-stats-header">
          <div class="pd-panel-icon"><i class="ti ti-database"></i></div>
          <span class="pd-panel-title orbitron">SYSTEM TELEMETRY</span>
          <div class="pd-panel-line"></div>
        </div>
        <div class="pd-stats-grid">
          <div class="pd-stat-card">
            <div class="pd-stat-icon"><i class="ti ti-tag"></i></div>
            <div class="pd-stat-info">
              <span class="pd-stat-label orbitron">CLASSIFICATION</span>
              <span class="pd-stat-value">{project.class}</span>
            </div>
            <div class="pd-stat-glow"></div>
          </div>
          <div class="pd-stat-card">
            <div class="pd-stat-icon pd-stat-icon-status" data-status={project.status}>
              <i class="ti ti-activity"></i>
            </div>
            <div class="pd-stat-info">
              <span class="pd-stat-label orbitron">SYSTEM STATUS</span>
              <span class="pd-stat-value">{project.status}</span>
            </div>
            <div class="pd-stat-glow"></div>
          </div>
          <div class="pd-stat-card">
            <div class="pd-stat-icon"><i class="ti ti-map-2"></i></div>
            <div class="pd-stat-info">
              <span class="pd-stat-label orbitron">OPERATIONAL SECTOR</span>
              <span class="pd-stat-value">{project.sector}</span>
            </div>
            <div class="pd-stat-glow"></div>
          </div>
          <div class="pd-stat-card">
            <div class="pd-stat-icon"><i class="ti ti-puzzle"></i></div>
            <div class="pd-stat-info">
              <span class="pd-stat-label orbitron">ACTIVE MODULES</span>
              <span class="pd-stat-value">{techItems.length} INTEGRATED</span>
            </div>
            <div class="pd-stat-glow"></div>
          </div>
        </div>
      </section>

      <!-- ═══ GALLERY ═══ -->
      {project.images && project.images.length > 0 && (
        <section class="pd-gallery">
          <div class="pd-stats-header">
            <div class="pd-panel-icon"><i class="ti ti-camera-code"></i></div>
            <span class="pd-panel-title orbitron">MISSION INTEL · VISUAL FEED</span>
            <div class="pd-panel-line"></div>
          </div>
          <div class="pd-gallery-grid">
            {project.images.map((img, i) => (
              <div class="pd-gal-card" style={`--gal-delay: ${i * 0.12}s`}>
                <div class="pd-gal-frame">
                  <img
                    src={typeof img === "string" ? img : img.src}
                    alt={`${project.name} visual ${i + 1}`}
                    loading="lazy"
                  />
                  <div class="pd-gal-hud">
                    <div class="pd-gal-hud-top">
                      <span class="pd-gal-tag orbitron">FEED_{String(i + 1).padStart(2, "0")}</span>
                      <span class="pd-gal-rec orbitron"><span class="pd-rec-dot"></span>REC</span>
                    </div>
                    <div class="pd-gal-hud-bottom">
                      <span class="pd-gal-res orbitron">1920×1080</span>
                      <span class="pd-gal-zoom"><i class="ti ti-arrows-maximize"></i></span>
                    </div>
                  </div>
                  <!-- Animated scan line across image -->
                  <div class="pd-gal-scan"></div>
                </div>
              </div>
            ))}
          </div>
        </section>
      )}

      <!-- ═══ ACTION BAR ═══ -->
      <section class="pd-cta" id="pd-cta">
        <div class="pd-cta-inner">
          <div class="pd-cta-label orbitron">
            <i class="ti ti-terminal-2"></i>
            EXECUTE OPERATIONS
          </div>
          <div class="pd-cta-btns">
            {project.viewUrl &&
              project.viewUrl !== "" &&
              project.viewUrl !== "#" && (
                <a href={project.viewUrl} class="pd-cta-btn pd-cta-cyan" target="_blank" rel="noopener noreferrer">
                  <span class="pd-cta-btn-bg"></span>
                  <i class="ti ti-rocket"></i>
                  <span>LAUNCH MISSION</span>
                </a>
              )}
            {project.codeUrl &&
              project.codeUrl !== "" &&
              project.codeUrl !== "#" && (
                <a href={project.codeUrl} class="pd-cta-btn pd-cta-purple" target="_blank" rel="noopener noreferrer">
                  <span class="pd-cta-btn-bg"></span>
                  <i class="ti ti-brand-github"></i>
                  <span>VIEW SOURCE</span>
                </a>
              )}
          </div>
        </div>
      </section>

      <!-- Footer sig -->
      <div class="pd-footer orbitron">
        <span>MISSION_DB :: ENCRYPTED CHANNEL :: {project.id.toUpperCase()}</span>
      </div>

    </div>
  </main>
</Layout>

<style>
  /* ═══════════════════════════════════════════════════
     PROJECT DETAIL — ULTRA PREMIUM v2
     ═══════════════════════════════════════════════════ */

  /* --- PAGE & BACKGROUNDS --- */
  .pd-page {
    position: relative;
    min-height: 100vh;
    background: #030712;
    overflow-x: hidden;
  }

  .pd-bg-grid {
    position: fixed; inset: 0;
    background-image:
      linear-gradient(rgba(0, 217, 255, 0.03) 1px, transparent 1px),
      linear-gradient(90deg, rgba(0, 217, 255, 0.03) 1px, transparent 1px);
    background-size: 60px 60px;
    pointer-events: none;
    z-index: 0;
  }

  .pd-bg-noise {
    position: fixed; inset: 0;
    background: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='0.03'/%3E%3C/svg%3E");
    pointer-events: none;
    z-index: 0;
    opacity: 0.5;
  }

  .pd-bg-vignette {
    position: fixed; inset: 0;
    background:
      radial-gradient(ellipse at 15% 5%, rgba(0, 217, 255, 0.07) 0%, transparent 45%),
      radial-gradient(ellipse at 85% 90%, rgba(123, 97, 255, 0.06) 0%, transparent 45%),
      radial-gradient(ellipse at 50% 50%, transparent 40%, rgba(0, 0, 0, 0.5) 100%);
    pointer-events: none;
    z-index: 0;
  }

  .pd-particles {
    position: fixed; inset: 0;
    pointer-events: none;
    z-index: 0;
  }

  .pd-data-stream {
    position: fixed;
    top: 0; right: 60px;
    width: 1px;
    height: 100vh;
    background: linear-gradient(to bottom, transparent, rgba(0, 217, 255, 0.15), transparent);
    pointer-events: none;
    z-index: 0;
    animation: pd-stream-move 4s ease-in-out infinite;
  }

  @keyframes pd-stream-move {
    0%,100% { opacity: 0.3; right: 60px; }
    50% { opacity: 0.8; right: 62px; }
  }

  .pd-container {
    position: relative;
    z-index: 1;
    max-width: 1140px;
    margin: 0 auto;
    padding: 80px 28px 50px;
    display: flex;
    flex-direction: column;
    gap: 32px;
  }

  /* --- NAV --- */
  .pd-nav {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 12px 0;
    animation: pd-slide-down 0.6s ease both;
  }

  .pd-back-btn {
    display: flex;
    align-items: center;
    gap: 12px;
    text-decoration: none;
    color: var(--text-muted);
    transition: all 0.3s ease;
  }
  .pd-back-btn:hover {
    color: var(--cyan);
    transform: translateX(-6px);
  }

  .pd-back-icon {
    width: 36px; height: 36px;
    display: flex; align-items: center; justify-content: center;
    border: 1px solid rgba(0, 217, 255, 0.2);
    background: rgba(0, 217, 255, 0.04);
    font-size: 18px;
    transition: all 0.3s ease;
  }
  .pd-back-btn:hover .pd-back-icon {
    border-color: var(--cyan);
    background: rgba(0, 217, 255, 0.1);
    box-shadow: 0 0 20px rgba(0, 217, 255, 0.15);
  }

  .pd-back-text {
    font-family: 'Orbitron', sans-serif;
    font-size: 10px;
    letter-spacing: 3px;
  }

  .pd-breadcrumbs {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 9px;
    letter-spacing: 2px;
  }
  .pd-crumb-dim { color: var(--text-muted); opacity: 0.5; }
  .pd-crumb-arrow { font-size: 10px; color: rgba(0, 217, 255, 0.2); }
  .pd-crumb-lit { color: var(--cyan); }

  /* --- HERO --- */
  .pd-hero {
    position: relative;
    padding: 56px 52px 0;
    background: linear-gradient(160deg, rgba(11, 16, 32, 0.95) 0%, rgba(3, 7, 18, 0.98) 100%);
    border: 1px solid rgba(0, 217, 255, 0.1);
    overflow: hidden;
    animation: pd-slide-up 0.7s ease both;
    animation-delay: 0.1s;
  }

  .pd-hero-glow {
    position: absolute;
    top: -50%; left: -20%;
    width: 70%; height: 200%;
    background: radial-gradient(ellipse, rgba(0, 217, 255, 0.04) 0%, transparent 60%);
    pointer-events: none;
  }

  .pd-hero-scanlines {
    position: absolute; inset: 0;
    background: repeating-linear-gradient(
      0deg, transparent, transparent 2px,
      rgba(0, 217, 255, 0.012) 2px, rgba(0, 217, 255, 0.012) 4px
    );
    pointer-events: none;
    z-index: 0;
  }

  /* HUD Corners */
  .pd-hud-corner {
    position: absolute;
    width: 20px; height: 20px;
    z-index: 5;
  }
  .pd-hud-tl { top: 8px; left: 8px; border-top: 2px solid var(--cyan); border-left: 2px solid var(--cyan); }
  .pd-hud-tr { top: 8px; right: 8px; border-top: 2px solid var(--cyan); border-right: 2px solid var(--cyan); }
  .pd-hud-bl { bottom: 8px; left: 8px; border-bottom: 2px solid var(--purple); border-left: 2px solid var(--purple); }
  .pd-hud-br { bottom: 8px; right: 8px; border-bottom: 2px solid var(--purple); border-right: 2px solid var(--purple); }

  .pd-hero-body {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 48px;
    padding-bottom: 40px;
    position: relative;
    z-index: 2;
  }

  .pd-hero-info { flex: 1; }

  /* Status pill */
  .pd-pill {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 5px 16px;
    border-radius: 100px;
    font-family: 'Orbitron', sans-serif;
    font-size: 9px;
    letter-spacing: 3px;
    border: 1px solid rgba(0, 217, 255, 0.3);
    background: rgba(0, 217, 255, 0.06);
    color: var(--cyan);
    margin-bottom: 24px;
  }
  .pd-pill[data-status="ACTIVE"] { border-color: rgba(0, 255, 136, 0.35); background: rgba(0, 255, 136, 0.06); color: #00ff88; }
  .pd-pill[data-status="IN PROGRESS"] { border-color: rgba(255, 187, 0, 0.35); background: rgba(255, 187, 0, 0.06); color: #ffbb00; }

  .pd-pill-dot {
    width: 5px; height: 5px;
    border-radius: 50%;
    background: currentColor;
    box-shadow: 0 0 6px currentColor, 0 0 12px currentColor;
    animation: pd-pulse 2s ease-in-out infinite;
  }

  /* Title with subtle glitch */
  .pd-title {
    font-size: clamp(2rem, 5vw, 3.8rem);
    font-weight: 900;
    letter-spacing: 8px;
    line-height: 1.05;
    margin-bottom: 16px;
    color: #fff;
    text-shadow: 0 0 60px rgba(0, 217, 255, 0.25), 0 0 120px rgba(123, 97, 255, 0.1);
    position: relative;
  }
  .pd-title::after {
    content: attr(data-text);
    position: absolute;
    top: 0; left: 0;
    color: var(--cyan);
    opacity: 0;
    clip-path: inset(0 0 0 0);
    animation: pd-glitch 8s ease-in-out infinite;
  }

  @keyframes pd-glitch {
    0%,92%,100% { opacity: 0; }
    93% { opacity: 0.6; clip-path: inset(20% 0 60% 0); transform: translateX(-3px); }
    94% { opacity: 0; }
    95% { opacity: 0.4; clip-path: inset(50% 0 20% 0); transform: translateX(3px); }
    96% { opacity: 0; }
  }

  .pd-class-line {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 20px;
  }
  .pd-class-bracket {
    color: var(--purple);
    font-family: 'Orbitron', sans-serif;
    font-size: 14px;
    opacity: 0.6;
  }
  .pd-class-text {
    font-family: 'Orbitron', sans-serif;
    font-size: 12px;
    letter-spacing: 6px;
    color: var(--purple);
    opacity: 0.75;
  }

  .pd-chip-row {
    display: flex;
    gap: 16px;
    flex-wrap: wrap;
  }

  .pd-chip {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 11px;
    color: var(--text-muted);
    padding: 6px 14px;
    background: rgba(255,255,255, 0.02);
    border: 1px solid rgba(255,255,255, 0.06);
    letter-spacing: 1px;
  }
  .pd-chip i { color: var(--cyan); font-size: 14px; }

  /* Emblem / Icon */
  .pd-emblem {
    position: relative;
    width: 160px; height: 160px;
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .pd-emblem-core {
    width: 72px; height: 72px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 36px;
    color: var(--cyan);
    background: rgba(0, 217, 255, 0.06);
    border: 1px solid rgba(0, 217, 255, 0.25);
    border-radius: 14px;
    position: relative;
    z-index: 3;
    box-shadow: 0 0 40px rgba(0, 217, 255, 0.1), inset 0 0 30px rgba(0, 217, 255, 0.04);
    transition: all 0.5s cubic-bezier(0.2, 0.8, 0.2, 1);
  }
  .pd-emblem:hover .pd-emblem-core {
    box-shadow: 0 0 60px rgba(0, 217, 255, 0.2), inset 0 0 40px rgba(0, 217, 255, 0.08);
    transform: scale(1.08) rotate(3deg);
    border-color: var(--cyan);
  }

  .pd-emblem-img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    border-radius: 10px;
  }

  .pd-ring {
    position: absolute;
    border-radius: 50%;
    border: 1px solid;
  }
  .pd-ring-1 {
    width: 100px; height: 100px;
    border-color: rgba(0, 217, 255, 0.12);
    border-style: dashed;
    animation: pd-spin 12s linear infinite;
  }
  .pd-ring-2 {
    width: 130px; height: 130px;
    border-color: rgba(123, 97, 255, 0.1);
    animation: pd-spin 18s linear infinite reverse;
  }
  .pd-ring-3 {
    width: 158px; height: 158px;
    border-color: rgba(0, 217, 255, 0.06);
    border-style: dotted;
    animation: pd-spin 25s linear infinite;
  }

  .pd-orbit-dot {
    position: absolute;
    width: 4px; height: 4px;
    border-radius: 50%;
    z-index: 4;
  }
  .pd-orbit-dot-1 {
    background: var(--cyan);
    box-shadow: 0 0 8px var(--cyan);
    animation: pd-orbit-1 12s linear infinite;
  }
  .pd-orbit-dot-2 {
    background: var(--purple);
    box-shadow: 0 0 8px var(--purple);
    animation: pd-orbit-2 18s linear infinite reverse;
  }

  @keyframes pd-orbit-1 {
    from { transform: rotate(0deg) translateX(50px) rotate(0deg); }
    to   { transform: rotate(360deg) translateX(50px) rotate(-360deg); }
  }
  @keyframes pd-orbit-2 {
    from { transform: rotate(0deg) translateX(65px) rotate(0deg); }
    to   { transform: rotate(360deg) translateX(65px) rotate(-360deg); }
  }

  /* Hero bottom bar */
  .pd-hero-bar {
    display: flex;
    align-items: center;
    gap: 32px;
    padding: 18px 0;
    border-top: 1px solid rgba(0, 217, 255, 0.08);
    position: relative;
    z-index: 2;
  }
  .pd-bar-item { display: flex; flex-direction: column; gap: 4px; }
  .pd-bar-label {
    font-family: 'Orbitron', sans-serif;
    font-size: 8px;
    letter-spacing: 3px;
    color: var(--text-muted);
    opacity: 0.5;
  }
  .pd-bar-value {
    font-family: 'Space Grotesk', sans-serif;
    font-size: 12px;
    color: var(--text-primary);
    letter-spacing: 1px;
  }
  .pd-bar-sep {
    width: 1px;
    height: 28px;
    background: linear-gradient(to bottom, transparent, rgba(0, 217, 255, 0.15), transparent);
  }

  /* --- DUAL PANEL GRID --- */
  .pd-dual-grid {
    display: grid;
    grid-template-columns: 1.25fr 1fr;
    gap: 28px;
    animation: pd-slide-up 0.7s ease both;
    animation-delay: 0.25s;
  }

  .pd-panel {
    background: rgba(11, 16, 32, 0.65);
    backdrop-filter: blur(16px);
    border: 1px solid rgba(0, 217, 255, 0.08);
    padding: 32px;
    position: relative;
    overflow: hidden;
    transition: border-color 0.4s ease;
  }
  .pd-panel:hover {
    border-color: rgba(0, 217, 255, 0.2);
  }

  /* Subtle top-left accent line */
  .pd-panel::before {
    content: '';
    position: absolute;
    top: 0; left: 0;
    width: 60px; height: 2px;
    background: linear-gradient(90deg, var(--cyan), transparent);
  }

  .pd-panel-header {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 28px;
  }
  .pd-panel-icon {
    width: 32px; height: 32px;
    display: flex; align-items: center; justify-content: center;
    font-size: 16px;
    color: var(--cyan);
    background: rgba(0, 217, 255, 0.06);
    border: 1px solid rgba(0, 217, 255, 0.15);
    border-radius: 8px;
  }
  .pd-panel-title {
    font-size: 11px;
    letter-spacing: 4px;
    color: var(--cyan);
  }
  .pd-panel-line {
    flex: 1;
    height: 1px;
    background: linear-gradient(90deg, rgba(0, 217, 255, 0.15), transparent);
  }

  /* Briefing */
  .pd-brief-body { margin-bottom: 24px; }
  .pd-brief-text {
    font-size: 14.5px;
    line-height: 1.9;
    color: var(--text-primary);
    opacity: 0.82;
  }

  /* Mini terminal */
  .pd-terminal {
    border: 1px solid rgba(0, 217, 255, 0.08);
    background: rgba(0, 0, 0, 0.5);
    border-radius: 8px;
    overflow: hidden;
  }
  .pd-terminal-header {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 8px 14px;
    background: rgba(0, 0, 0, 0.4);
    border-bottom: 1px solid rgba(255,255,255, 0.04);
  }
  .pd-term-dot { width: 8px; height: 8px; border-radius: 50%; }
  .pd-term-dot-r { background: #ff5f57; }
  .pd-term-dot-y { background: #febc2e; }
  .pd-term-dot-g { background: #28c840; }
  .pd-term-title {
    font-family: 'Space Grotesk', sans-serif;
    font-size: 10px;
    color: var(--text-muted);
    margin-left: 8px;
    letter-spacing: 1px;
  }
  .pd-terminal-body { padding: 14px 16px; }
  .pd-term-line {
    font-family: 'Space Grotesk', monospace;
    font-size: 12px;
    color: var(--text-muted);
    margin-bottom: 4px;
  }
  .pd-term-prompt { color: var(--cyan); margin-right: 8px; }
  .pd-term-output { color: #00ff88; }
  .pd-term-cursor {
    display: inline-block;
    width: 7px; height: 13px;
    background: var(--cyan);
    vertical-align: middle;
    animation: pd-blink 1s step-end infinite;
    margin-left: 4px;
  }

  /* Tech Arsenal */
  .pd-tech-list {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .pd-tech-row {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 10px 12px;
    background: rgba(0, 0, 0, 0.2);
    border: 1px solid rgba(255,255,255, 0.03);
    transition: all 0.3s ease;
    opacity: 0;
    animation: pd-fade-right 0.5s ease forwards;
    animation-delay: var(--delay);
  }
  .pd-tech-row:hover {
    background: rgba(0, 217, 255, 0.04);
    border-color: rgba(0, 217, 255, 0.12);
    transform: translateX(4px);
  }

  .pd-tech-idx {
    font-size: 9px;
    color: var(--cyan);
    opacity: 0.35;
    letter-spacing: 1px;
    width: 22px;
    flex-shrink: 0;
  }

  .pd-tech-bar {
    width: 50px;
    height: 3px;
    background: rgba(255,255,255, 0.05);
    border-radius: 3px;
    overflow: hidden;
    flex-shrink: 0;
  }
  .pd-tech-bar-fill {
    height: 100%;
    width: var(--width);
    background: linear-gradient(90deg, var(--cyan), var(--purple));
    border-radius: 3px;
    box-shadow: 0 0 6px rgba(0, 217, 255, 0.4);
  }

  .pd-tech-label {
    flex: 1;
    font-size: 13px;
    color: var(--text-primary);
    font-weight: 500;
    letter-spacing: 0.5px;
  }

  .pd-tech-stat {
    font-size: 9px;
    color: var(--cyan);
    opacity: 0.5;
    letter-spacing: 1px;
  }

  .pd-tech-footer {
    margin-top: 20px;
    padding: 10px 14px;
    text-align: center;
    font-size: 9px;
    letter-spacing: 3px;
    color: #00ff88;
    background: rgba(0, 255, 136, 0.04);
    border: 1px solid rgba(0, 255, 136, 0.1);
    border-radius: 6px;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
  }

  /* --- STATS --- */
  .pd-stats {
    animation: pd-slide-up 0.7s ease both;
    animation-delay: 0.35s;
  }

  .pd-stats-header {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 24px;
  }

  .pd-stats-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 16px;
  }

  .pd-stat-card {
    position: relative;
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 22px 18px;
    background: rgba(11, 16, 32, 0.7);
    backdrop-filter: blur(12px);
    border: 1px solid rgba(0, 217, 255, 0.07);

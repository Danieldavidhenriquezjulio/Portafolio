---
import Layout from "../layouts/Layout.astro";
---

<Layout title="404 - Signal Lost | DANIEL HENRIQUEZ">
  <main class="page-404">
    <div class="error-container">
      <div class="glitch-wrapper">
        <h1 class="error-code orbitron" data-text="404">404</h1>
      </div>
      <div class="error-info">
        <h2 class="orbitron">SIGNAL LOST</h2>
        <p class="error-desc">The requested coordinates could not be located in our navigation system.</p>
        <div class="error-terminal">
          <span class="error-prompt">❯</span>
          <span class="error-cmd">route.resolve()</span>
          <span class="error-result">ERROR: PATH_NOT_FOUND</span>
        </div>
      </div>
      <a href="/" class="btn btn-cyan error-btn">
        <i class="ti ti-home"></i> RETURN TO BASE
      </a>
    </div>
  </main>
</Layout>

<style>
  .page-404 {
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    background: #030712;
    position: relative;
    overflow: hidden;
  }

  .page-404::before {
    content: '';
    position: absolute;
    inset: 0;
    background:
      radial-gradient(ellipse at 30% 20%, rgba(0, 217, 255, 0.06) 0%, transparent 50%),
      radial-gradient(ellipse at 70% 80%, rgba(123, 97, 255, 0.05) 0%, transparent 50%);
    pointer-events: none;
  }

  .error-container {
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 32px;
    z-index: 1;
    padding: 40px;
  }

  .error-code {
    font-size: clamp(6rem, 15vw, 12rem);
    font-weight: 900;
    letter-spacing: 16px;
    color: transparent;
    -webkit-text-stroke: 2px var(--cyan);
    text-shadow: 0 0 80px rgba(0, 217, 255, 0.3);
    position: relative;
    line-height: 1;
  }

  .error-code::after {
    content: attr(data-text);
    position: absolute;
    top: 0; left: 0;
    color: var(--cyan);
    opacity: 0;
    -webkit-text-stroke: 0;
    animation: glitch-404 6s ease-in-out infinite;
  }

  @keyframes glitch-404 {
    0%,90%,100% { opacity: 0; }
    91% { opacity: 0.5; clip-path: inset(30% 0 50% 0); transform: translateX(-5px); }
    93% { opacity: 0; }
    94% { opacity: 0.3; clip-path: inset(60% 0 10% 0); transform: translateX(5px); }
    96% { opacity: 0; }
  }

  .error-info h2 {
    font-size: 20px;
    letter-spacing: 8px;
    color: var(--text-primary);
    margin-bottom: 12px;
  }

  .error-desc {
    font-size: 14px;
    color: var(--text-muted);
    max-width: 400px;
    line-height: 1.6;
    margin-bottom: 8px;
  }

  .error-terminal {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 10px 18px;
    background: rgba(0, 0, 0, 0.5);
    border: 1px solid rgba(0, 217, 255, 0.08);
    border-radius: 6px;
    font-family: 'Space Grotesk', monospace;
    font-size: 12px;
    margin-top: 12px;
  }

  .error-prompt { color: var(--cyan); font-weight: bold; }
  .error-cmd { color: var(--text-muted); }
  .error-result { color: #ff4444; margin-left: 8px; }

  .error-btn {
    margin-top: 8px;
    display: inline-flex;
    align-items: center;
    gap: 10px;
  }
</style>

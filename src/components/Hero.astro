---
import profilePic from "../assets/ImagenPeril.png";
---

<section id="hero">
  <div class="hero-left">
    <h2 class="hero-role">SYSTEMS ENGINEER</h2>
    <h3 class="hero-stack">FULL STACK DEVELOPER</h3>
    <h1 class="orbitron">DANIEL HENRIQUEZ</h1>

    <div class="status-indicators">
      <div><span class="status-dot"></span>SYSTEMS ONLINE</div>
      <div><span class="status-dot"></span>3 ACTIVE MISSIONS</div>
      <div><span class="status-dot"></span>CARTAGENA SECTOR</div>
    </div>

    <div>
      Full Stack Engineer & CTO building production SaaS from zero to launch. 
      Shipped Fe Viva (live faith-tech platform), architecting multi-tenant 
      systems with Next.js, NestJS & PostgreSQL. I turn ideas into deployed, 
      revenue-ready products.
    </div>
    <br />

    <div class="hero-ctas">
      <a href="#projects" class="btn btn-cyan"
        ><i class="ti ti-satellite"></i> [ EXPLORE MISSIONS ]</a
      >
      <a href="#contact" class="btn btn-purple"
        ><i class="ti ti-plug-connected"></i> [ OPEN CHANNEL ]</a
      >
      <a href="/Daniel-Henriquez-CV.pdf" download class="btn btn-cyan"
        ><i class="ti ti-download"></i> [ DOWNLOAD CV ]</a
      >
    </div>

    <br />

    <div class="footer-detail">10.3910° N · 75.4794° W · SECTOR DELTA-7</div>

    <div class="hero-socials">
      <a
        href="https://github.com/Danieldavidhenriquezjulio"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="GitHub"
      >
        <i class="ti ti-brand-github"></i>
      </a>
      <a
        href="https://www.linkedin.com/in/daniel-david-henriquez-julio-71327a310/"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="LinkedIn"
      >
        <i class="ti ti-brand-linkedin"></i>
      </a>
      <a href="mailto:danieldhj07@gmail.com" aria-label="Email">
        <i class="ti ti-mail"></i>
      </a>
    </div>
  </div>

  <div class="hero-right">
    <div class="orbital-core-node">
      <img
        src={profilePic.src}
        alt="Daniel Henriquez"
        class="core-profile-img"
      />
    </div>
    <div class="ring ring-1">
      <div class="satellite"><i class="ti ti-brand-javascript"></i></div>
    </div>
    <div class="ring ring-2">
      <div class="satellite"><i class="ti ti-brand-python"></i></div>
    </div>
    <div class="ring ring-3">
      <div class="satellite"><i class="ti ti-coffee"></i></div>
    </div>
  </div>
</section>

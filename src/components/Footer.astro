<footer class="site-footer">
  <div class="footer-inner">
    <div class="footer-top">
      <div class="footer-brand">
        <span class="footer-name orbitron">DANIEL HENRIQUEZ</span>
        <span class="footer-role">Full Stack Engineer · CTO</span>
      </div>
      <div class="footer-links">
        <a href="https://github.com/Danieldavidhenriquezjulio" target="_blank" rel="noopener noreferrer" aria-label="GitHub">
          <i class="ti ti-brand-github"></i>
        </a>
        <a href="https://www.linkedin.com/in/daniel-david-henriquez-julio-71327a310/" target="_blank" rel="noopener noreferrer" aria-label="LinkedIn">
          <i class="ti ti-brand-linkedin"></i>
        </a>
        <a href="mailto:danieldhj07@gmail.com" aria-label="Email">
          <i class="ti ti-mail"></i>
        </a>
      </div>
    </div>
    <div class="footer-divider"></div>
    <div class="footer-bottom">
      <span class="footer-copy">&copy; {new Date().getFullYear()} Daniel Henriquez. All rights reserved.</span>
      <span class="footer-loc orbitron">10.3910° N · 75.4794° W</span>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    padding: 0 5%;
    position: relative;
    z-index: 2;
  }

  .footer-inner {
    max-width: 1100px;
    margin: 0 auto;
    padding: 48px 0 32px;
    border-top: 1px solid rgba(0, 217, 255, 0.08);
  }

  .footer-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 24px;
  }

  .footer-brand {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .footer-name {
    font-size: 14px;
    letter-spacing: 4px;
    color: var(--text-primary);
  }

  .footer-role {
    font-size: 11px;
    color: var(--text-muted);
    letter-spacing: 1px;
  }

  .footer-links {
    display: flex;
    gap: 20px;
  }

  .footer-links a {
    color: var(--text-muted);
    font-size: 20px;
    transition: all 0.3s ease;
    text-decoration: none;
  }

  .footer-links a:hover {
    color: var(--cyan);
    filter: drop-shadow(0 0 8px rgba(0, 217, 255, 0.5));
    transform: translateY(-2px);
  }

  .footer-divider {
    height: 1px;
    background: linear-gradient(90deg, transparent, rgba(0, 217, 255, 0.1), rgba(123, 97, 255, 0.1), transparent);
    margin-bottom: 20px;
  }

  .footer-bottom {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .footer-copy {
    font-size: 11px;
    color: var(--text-muted);
    opacity: 0.5;
  }

  .footer-loc {
    font-size: 8px;
    letter-spacing: 3px;
    color: var(--text-muted);
    opacity: 0.3;
  }

  @media (max-width: 640px) {
    .footer-top { flex-direction: column; gap: 16px; text-align: center; }
    .footer-bottom { flex-direction: column; gap: 8px; text-align: center; }
  }
</style>

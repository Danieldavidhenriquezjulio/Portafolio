---

<section id="contact" class="transmission-center">
  <div class="section-header" style="text-align: center;">
    <div class="tag orbitron">[ TRANSMISSION CENTER ]</div>
    <h2 class="orbitron">OPEN COMMUNICATION CHANNEL</h2>
  </div>

  <div class="glass-panel contact-form">
    <form id="comm-form">
      <div class="form-row">
        <label for="name">TRANSMISSION ORIGIN (Name)</label>
        <input type="text" id="name" name="from_name" required autocomplete="off" />
      </div>
      <div class="form-row" style="margin-top: 24px;">
        <label for="email">SIGNAL FREQUENCY (Email)</label>
        <input type="email" id="email" name="from_email" required autocomplete="off" />
      </div>
      <div class="form-row" style="margin-top: 24px;">
        <label for="message">MESSAGE PAYLOAD</label>
        <textarea id="message" name="message" rows="4" required></textarea>
      </div>

      <div class="submit-container">
        <span class="sys-msg" id="form-msg">SIGNAL ACQUIRED...</span>
        <button type="submit" class="btn btn-cyan"
          >[ TRANSMIT MESSAGE → ]</button
        >
      </div>
    </form>
  </div>

  <div class="hero-socials">
    <a
      href="https://github.com/Danieldavidhenriquezjulio"
      target="_blank"
      rel="noopener noreferrer"
      aria-label="GitHub"
    >
      <i class="ti ti-brand-github"></i>
    </a>
    <a
      href="https://www.linkedin.com/in/daniel-david-henriquez-julio-71327a310/"
      target="_blank"
      rel="noopener noreferrer"
      aria-label="LinkedIn"
    >
      <i class="ti ti-brand-linkedin"></i>
    </a>
    <a href="mailto:danieldhj07@gmail.com" aria-label="Email">
      <i class="ti ti-mail"></i>
    </a>
  </div>
</section>
